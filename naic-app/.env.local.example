# Supabase — copy to .env.local and fill in from your project's
# Project Settings → API page. Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — Project Settings → API. Server-only, NEVER
# prefix with NEXT_PUBLIC_ or send to the browser. Used only to mark a
# program registration "paid" after Stripe confirms payment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Developers → API keys. Server-only secret key; use the sk_test_
# key until you're ready to take real payments, then swap for sk_live_.
STRIPE_SECRET_KEY=sk_test_your-secret-key
